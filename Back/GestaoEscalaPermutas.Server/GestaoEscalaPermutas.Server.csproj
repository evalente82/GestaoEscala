<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
		<SpaRoot>..\gestaoescalapermutas.client</SpaRoot>
		<SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:5173</SpaProxyServerUrl>
		<InvariantGlobalization>false</InvariantGlobalization>
		<PublishTrimmed>false</PublishTrimmed>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<PreserveCompilationContext>true</PreserveCompilationContext>
    <PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
    <Version>$(VersionPrefix)</Version>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Controllers\Empresa\**" />
		<Compile Remove="Controllers\Permuta\**" />
		<Compile Remove="Models\Empresa\**" />
		<Content Remove="Controllers\Empresa\**" />
		<Content Remove="Controllers\Permuta\**" />
		<Content Remove="Models\Empresa\**" />
		<EmbeddedResource Remove="Controllers\Empresa\**" />
		<EmbeddedResource Remove="Controllers\Permuta\**" />
		<EmbeddedResource Remove="Models\Empresa\**" />
		<None Remove="Controllers\Empresa\**" />
		<None Remove="Controllers\Permuta\**" />
		<None Remove="Models\Empresa\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Controllers\Escala\EscalaController.cs~RF664ededa.TMP" />
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="FirebaseAdmin" Version="3.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" /> 
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.6.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="7.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    </ItemGroup>
  


	<ItemGroup>
		<ProjectReference Include="..\GestaoEscalaPermutas.Dominio\GestaoEscalaPermutas.Dominio.csproj" />
		<ProjectReference Include="..\GestaoEscalaPermutas.Repository\GestaoEscalaPermutas.Repository.csproj" />
	</ItemGroup>
	
	<ItemGroup>
	  <Folder Include="out\" />
	</ItemGroup>

	<Target Name="ForceTokenVersionBinding" AfterTargets="Build">
		<PropertyGroup>
			<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		</PropertyGroup>
	</Target>

</Project>
