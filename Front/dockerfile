# Etapa 1: Build do frontend
FROM node:18 AS build
WORKDIR /app

# Copiar arquivos de dependência para cache
COPY package*.json ./

# Instalar dependências
RUN npm install --legacy-peer-deps

# Copiar todo o código-fonte e o .env (IMPORTANTE)
COPY . .

# Build do projeto (VITE lê o .env e substitui import.meta.env)
RUN npm run build

# Etapa 2: Servidor Nginx para servir o build estático
FROM nginx:alpine
RUN apk add --no-cache gettext

# Copiar build estático para o Nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Copiar configuração Nginx (template com porta fixa 80)
COPY default.conf.template /etc/nginx/conf.d/default.conf

# Expor porta padrão 80 (esperada pelo Fly)
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
